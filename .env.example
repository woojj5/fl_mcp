# Copy to .env and replace both secrets with random values of at least 32 characters.
FL_API_TOKEN=replace-with-a-random-secret-at-least-32-characters
FL_DASHBOARD_USER=admin
FL_DASHBOARD_PASSWORD=replace-with-a-different-random-password

FL_MODEL=simple_cnn
FL_DATASET=cifar10
FL_ROUNDS=20
FL_MIN_CLIENTS=2
FL_CLIENTS_PER_ROUND=2
FL_NUM_CLIENTS=2
FL_SPLIT=iid
FL_ALPHA=0.5
FL_LOCAL_EPOCH=5
FL_LR=0.01
FL_BATCH=32
FL_STRATEGY=fedavg
